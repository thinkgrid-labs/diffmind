# Rust
target/
Cargo.lock

# Node
node_modules/
dist/
*.js.map
pkg/
.npm/
.pnpm-debug.log*

# npm packaging — release binaries are injected by npm/scripts/prepare.mjs
# at publish time and must never be committed
npm/platform/*/bin/
*.tgz

# Model cache (never commit the GGUF file)
*.gguf
*.gguf.part
*.receipt.json
models/

# .diffmind holds both generated state and files a team is meant to commit,
# so ignore it selectively rather than wholesale. config.toml, rules.toml and
# baseline.json are project configuration and belong in version control.
.diffmind/symbols.json
.diffmind/cache/
.diffmind/daemon.json

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

